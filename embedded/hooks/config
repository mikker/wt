# .wt/config — key = value lines, read by the wt binary.
#
# Worktrees live at .wt/worktrees by default. Set an absolute path or one
# relative to the main checkout to put them elsewhere.
#
# worktrees = ../shared-worktrees
#
# Uncomment to keep this project's worktrees around after `wt done`/`wt
# ship` instead of tearing them down (useful when `.wt/create` is slow
# enough that spinning up a fresh worktree per task hurts). `wt done`/`wt
# ship --rm` still forces teardown one-off; `wt persist` toggles it per
# worktree.
#
# persistent = true
