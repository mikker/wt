#!/bin/sh
# .wt/create — runs after `git worktree add`, cwd = the new worktree.
# $1 = absolute path of the main checkout.
#
# If carry_ignored = true, ignored files are already copy-on-write cloned here
# when the filesystem supports reflinks. Install missing dependencies, copy
# missing secrets/keys, configure shared state, etc. A failing create hook
# reports the failure but leaves the worktree in place, so it's safe to fix and
# re-run by hand.
#
# Examples (uncomment and adapt):
#
# test -d vendor/bundle || bundle install
# test -f config/master.key || cp "$1/config/master.key" config/master.key
