#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

die() {
  echo "release: $*" >&2
  exit 1
}

[[ "$(git branch --show-current)" == "main" ]] || die "run this from main"
[[ -z "$(git status --porcelain)" ]] || die "working tree is not clean"

git fetch origin main --tags
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || die "main is not synchronized with origin/main"

latest="$(git ls-remote --tags --refs origin \
  | awk '{ sub("refs/tags/", "", $2); if ($2 ~ /^0\.[1-9][0-9]*$/) print $2 }' \
  | sort -t. -k2,2n \
  | tail -1)"
if [[ -z "$latest" ]]; then
  version="0.1"
else
  version="0.$((10#${latest#0.} + 1))"
fi

git rev-parse --verify "refs/tags/$version" >/dev/null 2>&1 && die "tag $version already exists locally"
git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1 && die "tag $version already exists on origin"
if command -v gh >/dev/null 2>&1 && gh release view "$version" >/dev/null 2>&1; then
  die "GitHub release $version already exists"
fi

echo "Releasing $version"
go vet ./...
go test ./...
go build -o wt .
if command -v goreleaser >/dev/null 2>&1; then
  goreleaser check
fi

git tag -a "$version" -m "Release $version"
if ! git push --atomic origin main "$version"; then
  git tag -d "$version"
  die "push failed; no remote release was created"
fi

echo "Release $version is running at https://github.com/mikker/wt/actions"
